{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptKit",
  "version": "0.0.0",
  "identifier": "com.ossianhempel.promptkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C ../.. build && node ../../scripts/bundle-daemon.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PromptKit",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/daemon/**",
      "resources/node/**"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
